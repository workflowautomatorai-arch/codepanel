{
  "name": "codepanel",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "build": "node scripts/build-config.js && cross-env NODE_ENV=production rimraf dist dist-electron release && vite build && tsc -p tsconfig.electron.json && electron-builder",
    "compile:renderer": "tsc --noEmit",
    "compile:electron": "tsc -p tsconfig.electron.json --noEmit",
    "compile": "concurrently \"npm:compile:renderer\" \"npm:compile:electron\"",
    "lint": "eslint \"{src,electron}/**/*.{ts,tsx,js}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\" && eslint \"{src,electron}/**/*.{ts,tsx,js}\" --fix",
    "dev:watch-electron": "cross-env NODE_ENV=development tsc -w -p tsconfig.electron.json",
    "dev:serve-renderer": "cross-env NODE_ENV=development vite",
    "dev": "concurrently \"npm:dev:watch-electron\" \"npm:dev:serve-renderer\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:electron": "jest --config=jest.electron.config.js --passWithNoTests",
    "test:renderer": "jest --config=jest.renderer.config.js --passWithNoTests"
  },
  "build": {
    "appId": "com.local.codepanel",
    "productName": "CodePanel",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "asar": true,
    "compression": "maximum",
    "generateUpdatesFilesForAllChannels": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "CodePanel-Mac-${arch}-${version}.${ext}",
      "icon": "assets/icons/mac/icon-256x256.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "identity": "Developer ID Application",
      "type": "distribution",
      "protocols": {
        "name": "codepanel-protocol",
        "schemes": [
          "codepanel"
        ]
      },
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/win/icon-256x256.ico",
      "artifactName": "CodePanel-Windows-${version}.${ext}",
      "protocols": {
        "name": "codepanel-protocol",
        "schemes": [
          "codepanel"
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/png/icon-256x256.png",
      "artifactName": "CodePanel-Linux-${version}.${ext}",
      "protocols": {
        "name": "codepanel-protocol",
        "schemes": [
          "codepanel"
        ]
      }
    },
    "publish": [],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    }
  },
  "keywords": [
    "electron",
    "desktop",
    "coding",
    "interview",
    "assistant",
    "developer-tools",
    "react",
    "typescript"
  ],
  "author": "dkhorev",
  "license": "MIT",
  "description": "Code assistance overlay panel",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.15",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "tailwind-merge": "^3.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "@electron/typescript-definitions": "^9.1.5",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.35.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/color": "^4.2.0",
    "@types/diff": "^7.0.2",
    "@types/electron-store": "^1.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "ts-jest": "^29.4.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
